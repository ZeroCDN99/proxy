:{$PORT:80} {
    # 1. Запрет прямого доступа к боту и базе данных
    @blocked path /bot.php* /db.php*
    respond @blocked 403

    # 2. Отсечение ботов и сканеров: если нет параметра token, сразу отдаем OK без обращения к Alwaysdata
    @notoken {
        not query token=*
    }
    respond @notoken "OK" 200

    # 3. Обратный прокси через IPv6 Alwaysdata в обход блокировки IPv4
    reverse_proxy https://[2a00:b6e0:1:20:19::1]:443 {
        header_up Host zerosan.alwaysdata.net
        header_up X-Fwd-Ip {remote_host}
        header_up X-Fwd-Secret "968f6dacaf5292b98bef45591d73e0402a13cb8884c8bb7a"
        header_up X-Fwd-Proto "https"
        header_up X-Fwd-Host "cozy-market.zeabur.app"
        header_down X-Mirror "cozy-market.zeabur.app"

        transport http {
            tls
            tls_server_name zerosan.alwaysdata.net
            dial_timeout 5s
        }
    }
}
