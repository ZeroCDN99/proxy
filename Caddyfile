:{$PORT:80} {
    @blocked path /bot.php* /db.php*
    respond @blocked 403

    # Отсекаем запросы без токена сразу, не нагружая Alwaysdata
    @notoken {
        not query token=*
    }
    respond @notoken "OK" 200

    reverse_proxy https://zerosan.alwaysdata.net {
        header_up Host zerosan.alwaysdata.net
        header_up X-Fwd-Ip {remote_host}
        header_up X-Fwd-Secret "968f6dacaf5292b98bef45591d73e0402a13cb8884c8bb7a"
        header_up X-Fwd-Proto "https"
        header_up X-Fwd-Host "cozy-market.zeabur.app"
        header_down X-Mirror "cozy-market.zeabur.app"

        transport http {
            tls
            dial_timeout 5s
        }
    }
}
